# Copier ce fichier en `.env` et renseigner les valeurs. Ne jamais committer `.env`.

# --- LLM ---
# Clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optionnel : minimal | low | medium | high (valeurs acceptées selon le modèle).
GEMINI_THINKING_LEVEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Au-delà, le corps de l'email est tronqué avant l'envoi au LLM (maîtrise des coûts).
LLM_MAX_BODY_CHARS=8000
# Nombre maximal d'appels LLM simultanés lors d'une analyse par lot.
LLM_MAX_CONCURRENCY=5

# --- Boîte mail ---
# "mock" pour développer sans vraie boîte, "gmail" pour l'API Gmail.
EMAIL_PROVIDER=mock
# Client OAuth "Application de bureau" téléchargé depuis la Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials.json
# Généré par `python -m scripts.authorize_gmail`. Contient un refresh token : c'est un secret.
GMAIL_TOKEN_PATH=token.json
# Syntaxe de recherche Gmail (ex: "is:unread category:primary").
GMAIL_QUERY=in:inbox is:unread
GMAIL_TIMEOUT_SECONDS=30
GMAIL_MAX_RETRIES=3
MAX_EMAILS=10

# --- Application ---
LOG_LEVEL=INFO
